{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neonstudy-sync",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neonstudy-progress",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}